<?xml version="1.0" encoding="utf-8"?>
<!--
  minWidth/minHeight match PocketOmahaWidget's SMALL DpSize; maxResizeWidth/
  maxResizeHeight match its LARGE one — the largest bucket, which shows the
  full holding list, is the one a resize should actually be able to reach.
  Some launchers (Samsung's One UI among them) compute their own effective
  resize ceiling from the grid regardless of these two, so the declared
  values are a floor for stricter launchers rather than a hard promise.

  updatePeriodMillis is 0 — deliberately not relied on. Glance's own guidance
  is that anything under ~30 minutes or needing network belongs in
  WorkManager; WidgetRefreshWorker (in :app, hourly) is the only refresh path.

  configure points at :app's WidgetConfigActivity because configuration is
  mandatory here, not optional: the widget has no default watchlist to fall
  back to, unlike a price widget that could default to "whatever's first."
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="380dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:configure="com.zandaulion.omaha.app.widget.WidgetConfigActivity"
    android:initialLayout="@layout/glance_default_loading_layout" />
