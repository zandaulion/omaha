<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground layer.

  Same artwork as web/icons/icon.svg (the PWA's app icon), not a fresh
  design — a health ring open at the upper-left, and the fortress/top-hat
  "moat" emblem with its sigma ribbon and gold spark. The outer <group>
  re-centers that 512x512 artwork's own coordinates into the 108x108
  adaptive canvas at 18% scale (its emblem bounding box, unstroked, ends up
  ~68dp across — inside the 66dp guaranteed-visible safe zone with a little
  margin for how launchers vary in where they crop).

  VectorDrawable has no stroke-dasharray, so the glowing ring's gap (the
  source SVG's dasharray="900 1200" after its rotate(-90)) is authored
  directly as a 271.4deg arc from the top point to its computed end point,
  rather than a full circle plus a dash pattern.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.18"
        android:scaleY="0.18"
        android:translateX="-202"
        android:translateY="-202">

        <!-- Outer subtle ring: two clockwise semicircles, top to bottom and back. -->
        <path
            android:pathData="M256,66 A190,190 0 1,1 256,446 A190,190 0 1,1 256,66"
            android:strokeColor="#FF1E293B"
            android:strokeWidth="8"
            android:fillColor="#00000000" />

        <!-- Glowing health ring: 271.4deg clockwise from the top, gap at upper-left. -->
        <path
            android:pathData="M256,66 A190,190 0 1,1 66.06,251.36"
            android:strokeWidth="16"
            android:strokeLineCap="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="66"
                    android:startY="66"
                    android:endX="446"
                    android:endY="446">
                    <item android:offset="0" android:color="#FF10B981" />
                    <item android:offset="1" android:color="#FF06B6D4" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fortress / top-hat "moat" emblem, local to the source SVG's own translate(136,126). -->
        <group
            android:translateX="136"
            android:translateY="126">

            <!-- Brim -->
            <path
                android:pathData="M30,190 A90,18 0 1,1 210,190 A90,18 0 1,1 30,190"
                android:fillColor="#FF1E293B"
                android:strokeColor="#FF334155"
                android:strokeWidth="4" />

            <!-- Crown. Stroke simplified to flat emerald from the source's ring gradient —
                 a gradient this thin reads as a solid colour at launcher-icon sizes anyway. -->
            <path
                android:pathData="M60,185 L75,70 C75,60 85,55 95,55 L145,55 C155,55 165,60 165,70 L180,185 Z"
                android:fillColor="#FF0F172A"
                android:strokeColor="#FF10B981"
                android:strokeWidth="6" />

            <!-- Ribbon -->
            <path android:pathData="M67,145 L173,145 L177,175 L63,175 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="63"
                        android:startY="145"
                        android:endX="177"
                        android:endY="175">
                        <item android:offset="0" android:color="#FF10B981" />
                        <item android:offset="1" android:color="#FF06B6D4" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Sigma / moat-value mark -->
            <path
                android:pathData="M105,152 L135,152 L118,160 L135,168 L105,168"
                android:strokeColor="#FF0F172A"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:fillColor="#00000000" />

            <!-- Upward momentum spark -->
            <path android:pathData="M120,15 L128,35 L148,43 L128,51 L120,71 L112,51 L92,43 L112,35 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="92"
                        android:startY="15"
                        android:endX="148"
                        android:endY="71">
                        <item android:offset="0" android:color="#FFFDE047" />
                        <item android:offset="1" android:color="#FFF59E0B" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
</vector>
