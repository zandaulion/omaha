<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Market data leaves the device; personal data does not. Doc 13 §6 lists
         what crosses the boundary, exhaustively. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Alerts are local: the sweep runs on device and posts to the shade.
         Nothing is transmitted to deliver one, and there is no push service.
         Runtime-requested on 13+; on earlier releases the grant is implicit,
         which is why AlertNotifier checks areNotificationsEnabled() as well —
         a person can still switch them off from system settings there. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OmahaApplication"
        android:label="Pocket Omaha"
        android:supportsRtl="true"
        android:theme="@style/Theme.Omaha">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
