FROM docker.io/library/node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# core/ holds the shared engine that server/ imports from. Without it the
# image builds cleanly and then dies at startup on ERR_MODULE_NOT_FOUND, so
# this line has to move whenever the import graph does.
COPY core ./core
COPY server ./server
COPY web ./web

# Create appuser with non-root UID
RUN addgroup -g 10005 appgroup && \
    adduser -u 10005 -G appgroup -s /bin/sh -D appuser && \
    mkdir -p /data && chown -R 10005:10005 /data /app

VOLUME /data
ENV DATA_DIR=/data
ENV PORT=3000

USER 10005
EXPOSE 3000

CMD ["node", "server/index.js"]
